{% extends "../base.njk" %}
{% block content %}
<div class="service-banner-img">
    <div class="ovrllay">
        {% include "navbar.njk" %}
        <section id="banner" class="py-70">
            <div class="container">
                <div class="row py-70">
                    <div id="banner-text" class="col-md-12 text-c">
                        <div class="left-borders">
                            <h5 class="wow fadeInUp main-about_h" data-wow-delay="0.2s">OUR TEAM</h5>
                            <p class="banner-text wow fadeInUp main-h3" data-wow-delay="0.8s">
                                <span class="c_yellow">MEET THE TEAM</span> | OUR<br>LEGAL EXPERTS
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<!-- Managing Partner Section -->
<div class="py-70 bg_gradient_team">
    <div class="container">
        <div class="row text-center mb-60">
            <div class="title wow fadeInUp">
                <h1>Managing Partner</h1>
                <div class="hed_img">
                    <img src="assets/images/headding-img.png">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-10 col-md-offset-1 text-center">
                <div class="managing-partner wow fadeInUp">
                    <div class="partner-image">
                        <img src="assets/images/founder(1).jpg" alt="Managing Partner" class="rounded-circle mb-4">
                    </div>
                    <h2 class="partner-name">Managing Partner Name</h2>
                    <p class="partner-title">Founder & Managing Partner</p>
                    <div class="partner-description mt-4">
                        Agaba Saimon is the visionary Founding Partner and Managing
                        Partner of Remedium Advocates. He brings over a decade of
                        distinguished legal experience spanning litigation, regulatory
                        advisory, corporate law, public governance, and tax strategy.
                        A nationally respected authority on land law, tax disputes,
                        and legal compliance, Saimon has successfully represented
                        clients before courts, tax tribunals, and regulatory bodies.
                        His prior leadership as Registrar and Board Secretary at the
                        Architects Registration Board saw him spearhead statutory
                        reforms, where he played a leading role in coordinating
                        stakeholder engagement on reforms to the Building Control
                        Act and enhancing institutional collaboration with the
                        National Building Review Board (NBRB).
                        He is particularly lauded for his ability to blend legal precision
                        with policy insight—and served as a legal and policy advisor
                        to the Uganda Parliamentary Forum on Social Protection,
                        and served as Company Secretary to leading civic and
                        development institutions. His consultancy portfolio includes
                        legal support to tourism associations, SMEs, NGOs, and
                        international development projects.
                        Saimon holds a Bachelor of Laws from Makerere University,
                        a Postgraduate Diploma in Legal Practice, a Postgraduate
                        Diploma in Public Administration, and certifications in
                        Arbitration and Monitoring & Evaluation. He is currently
                        pursuing an MBA and ICSA Company Secretarial qualification.
                        He is a Notary Public, Commissioner for Oaths, and active
                        member of the Uganda and East African Law Societies.
                        His leadership defines Remedium’s professional ethos:
                        strategy, integrity, and legal mastery.

                    </div>
                    <div class="partner-credentials mt-4">
                        <ul class="list-unstyled">
                            <li>Advocate of the High Court</li>
                            <li>Notary Public</li>
                            <li>Governance Expert</li>
                            <li>Policy Advisor</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Call to Action Section -->
<div class="our_partners_area bg_gradient_team">
    <div class="book_now_aera">
        <div class="container">
            <div class="row book_now">
                <div class="col-md-7 booking_text">
                    <h4>Work with Our Expert Legal Team</h4>
                    <p>Schedule a consultation with our experienced attorneys to discuss your legal needs.</p>
                </div>
                <div class="col-md-5 p0 book_bottun">
                    <div class="col-md-5">
                    </div>
                    <div class="col-md-7">
                        <div class="top-banner wow fadeInRight text-left">
                            <a href="/contact" class="btn btn-primary radius-50 wow fadeInUp js-scroll-trigger"
                                data-wow-delay="0.5s">Free Consultation</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block styles %}
<style>
    .managing-partner {
        padding: 40px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    }

    .managing-partner img {
        width: 200px;
        height: 200px;
        object-fit: cover;
        border: 4px solid #f8f9fa;
    }

    .partner-name {
        color: #333;
        font-size: 2.5em;
        margin-top: 20px;
    }

    .partner-title {
        color: #666;
        font-size: 1.2em;
        margin-bottom: 20px;
    }

    .partner-credentials ul {
        display: inline-block;
        text-align: left;
    }

    .partner-credentials li {
        margin-bottom: 10px;
        color: #666;
    }

    .team-member {
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }

    .team-member:hover {
        transform: translateY(-5px);
    }

    .member-image img {
        width: 100%;
        height: 300px;
        object-fit: cover;
    }

    .member-info {
        padding: 20px;
    }

    .member-info h3 {
        color: #333;
        margin-bottom: 5px;
    }

    .member-info .position {
        color: #666;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .member-info .specialty {
        color: #c5a47e;
        margin-bottom: 10px;
    }

    .member-info .description {
        color: #777;
        font-size: 0.9em;
        line-height: 1.6;
    }
</style>
{% endblock %}