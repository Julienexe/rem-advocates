{% extends "../base.njk" %}
{% block content %}
<div class="service-banner-img">
  <div class="ovrllay">
    <section id="banner" class="py-70">
      <div class="container">
        <div class="row py-70">
          <div id="banner-text" class="col-md-12 text-c">
            <div class="left-borders">
              <h5 class="wow fadeInUp main-about_h" data-wow-delay="0.2s">OUR TEAM</h5>
              <p class="banner-text wow fadeInUp main-h3" data-wow-delay="0.8s">
                <span class="c_yellow">MEET THE TEAM</span> | OUR<br>LEGAL EXPERTS
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<!-- Managing Partner Section -->
<div class="py-70 bg_gradient_team">
  <div class="container">
    <div class="row text-center mb-60">
      <div class="title wow fadeInUp">
        <h1>Managing Partner</h1>
        <div class="hed_img">
          <img src="/images/headding-img.png">
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-10 col-md-offset-1 text-center">
        <div class="managing-partner wow fadeInUp">
          <div class="partner-image">
            <img src="/images/founder.jpg" alt="Managing Partner" class="rounded-circle mb-4">
          </div>
          <h2 class="partner-name">Managing Partner Name</h2>
          <p class="partner-title">Founder & Managing Partner</p>
          <div class="partner-description mt-4">
            <p>With over 25 years of experience in corporate and commercial law, our managing partner has established a reputation for excellence in legal practice. Their expertise spans multiple areas of law, including corporate restructuring, mergers and acquisitions, and international business law.</p>
            <p>Under their leadership, our firm has grown to become one of the most respected legal practices in Uganda.</p>
          </div>
          <div class="partner-credentials mt-4">
            <ul class="list-unstyled">
              <li>LLB (Hons) - Law School</li>
              <li>Member of the Uganda Law Society</li>
              <li>Certified Corporate Law Specialist</li>
              <li>Published Author in Commercial Law</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Team Members Section -->
<div class="py-70">
  <div class="container">
    <div class="row text-center mb-60">
      <div class="title wow fadeInUp">
        <h1>Our Legal Team</h1>
        <div class="hed_img">
          <img src="/images/headding-img.png">
        </div>
        <p>Expert attorneys dedicated to your success</p>
      </div>
    </div>

    <div class="row">
      <!-- Senior Partner 1 -->
      <div class="col-md-4 col-sm-6 mb-4 wow fadeInUp">
        <div class="team-member">
          <div class="member-image">
            <img src="/images/team1.jpg" alt="Team Member">
          </div>
          <div class="member-info text-center">
            <h3>Partner Name</h3>
            <p class="position">Senior Partner</p>
            <p class="specialty">Corporate Law</p>
            <p class="description">Specializing in mergers and acquisitions with extensive experience in corporate law.</p>
          </div>
        </div>
      </div>

      <!-- Senior Partner 2 -->
      <div class="col-md-4 col-sm-6 mb-4 wow fadeInUp" data-wow-delay="0.2s">
        <div class="team-member">
          <div class="member-image">
            <img src="/images/team2.jpg" alt="Team Member">
          </div>
          <div class="member-info text-center">
            <h3>Partner Name</h3>
            <p class="position">Senior Partner</p>
            <p class="specialty">Real Estate Law</p>
            <p class="description">Expert in property law and real estate transactions with extensive experience.</p>
          </div>
        </div>
      </div>

      <!-- Senior Partner 3 -->
      <div class="col-md-4 col-sm-6 mb-4 wow fadeInUp" data-wow-delay="0.4s">
        <div class="team-member">
          <div class="member-image">
            <img src="/images/team3.jpg" alt="Team Member">
          </div>
          <div class="member-info text-center">
            <h3>Partner Name</h3>
            <p class="position">Senior Partner</p>
            <p class="specialty">Litigation</p>
            <p class="description">Leading our litigation team with a strong track record in complex disputes.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="row mt-4">
      <!-- Associate 1 -->
      <div class="col-md-4 col-sm-6 mb-4 wow fadeInUp">
        <div class="team-member">
          <div class="member-image">
            <img src="/images/team4.jpg" alt="Team Member">
          </div>
          <div class="member-info text-center">
            <h3>Associate Name</h3>
            <p class="position">Associate</p>
            <p class="specialty">Tax Law</p>
            <p class="description">Specialized in tax planning and compliance for both individuals and corporations.</p>
          </div>
        </div>
      </div>

      <!-- Associate 2 -->
      <div class="col-md-4 col-sm-6 mb-4 wow fadeInUp" data-wow-delay="0.2s">
        <div class="team-member">
          <div class="member-image">
            <img src="/images/team5.jpg" alt="Team Member">
          </div>
          <div class="member-info text-center">
            <h3>Associate Name</h3>
            <p class="position">Associate</p>
            <p class="specialty">Intellectual Property</p>
            <p class="description">Focusing on IP protection and technology law with expertise in patent litigation.</p>
          </div>
        </div>
      </div>

      <!-- Associate 3 -->
      <div class="col-md-4 col-sm-6 mb-4 wow fadeInUp" data-wow-delay="0.4s">
        <div class="team-member">
          <div class="member-image">
            <img src="/images/team6.jpg" alt="Team Member">
          </div>
          <div class="member-info text-center">
            <h3>Associate Name</h3>
            <p class="position">Associate</p>
            <p class="specialty">Employment Law</p>
            <p class="description">Dedicated to resolving workplace disputes and employment compliance issues.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Call to Action Section -->
<div class="our_partners_area bg_gradient_team">
  <div class="book_now_aera">
    <div class="container">
      <div class="row book_now">
        <div class="col-md-7 booking_text">
          <h4>Work with Our Expert Legal Team</h4>
          <p>Schedule a consultation with our experienced attorneys to discuss your legal needs.</p>
        </div>
        <div class="col-md-5 p0 book_bottun">
          <div class="col-md-5">
          </div>
          <div class="col-md-7">
            <div class="top-banner wow fadeInRight text-left">
              <a href="/contact" class="btn btn-primary radius-50 wow fadeInUp js-scroll-trigger" data-wow-delay="0.5s">Free Consultation</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block styles %}
<style>
.managing-partner {
  padding: 40px;
  background: #fff;
  border-radius: 8px;
  box-shadow: 0 0 20px rgba(0,0,0,0.1);
}

.managing-partner img {
  width: 200px;
  height: 200px;
  object-fit: cover;
  border: 4px solid #f8f9fa;
}

.partner-name {
  color: #333;
  font-size: 2.5em;
  margin-top: 20px;
}

.partner-title {
  color: #666;
  font-size: 1.2em;
  margin-bottom: 20px;
}

.partner-credentials ul {
  display: inline-block;
  text-align: left;
}

.partner-credentials li {
  margin-bottom: 10px;
  color: #666;
}

.team-member {
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 0 15px rgba(0,0,0,0.1);
  transition: transform 0.3s ease;
}

.team-member:hover {
  transform: translateY(-5px);
}

.member-image img {
  width: 100%;
  height: 300px;
  object-fit: cover;
}

.member-info {
  padding: 20px;
}

.member-info h3 {
  color: #333;
  margin-bottom: 5px;
}

.member-info .position {
  color: #666;
  font-weight: bold;
  margin-bottom: 5px;
}

.member-info .specialty {
  color: #c5a47e;
  margin-bottom: 10px;
}

.member-info .description {
  color: #777;
  font-size: 0.9em;
  line-height: 1.6;
}
</style>
{% endblock %}
